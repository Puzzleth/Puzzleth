// Browsers only let audio start from a click, tap or key press. pygbag plays pygame's music through
// an <audio> element (a "track" in window.MM); the game names the one it wants with
// puzzleth_want_music() (see puzzleth/web.py), and the next gesture starts it from inside the
// gesture, which iPhones require. A play() refused before that is expected, so it is kept from
// reaching pygbag's handler, which would show it as an "Error occurred" alert.
window.addEventListener("unhandledrejection", (e) => {
    if (e.reason && e.reason.name === "NotAllowedError") {
        e.preventDefault()
        e.stopImmediatePropagation()
    }
}, true)

var puzzleth_music = 0

function puzzleth_media() {
    const track = puzzleth_music && window.MM && MM[puzzleth_music]
    return track && track.media
}

function puzzleth_want_music(trackid) {
    puzzleth_music = trackid
}

function puzzleth_music_pos() {
    const media = puzzleth_media()
    return media ? media.currentTime : 0
}

function puzzleth_music_length() {
    const media = puzzleth_media()
    return media && isFinite(media.duration) ? media.duration : 0
}

function puzzleth_music_ended() {
    const media = puzzleth_media()
    return media ? media.ended : false
}

// The web build serves music next to the page instead of inside the game's download (see
// tools/build_web.sh), and the page plays it: the game hands over the list of songs once
// (puzzleth_play_music), and one <audio> element streams them in a shuffled loop, each fading in and
// out, downloading only the song that is playing. The page moves on to the next song by itself, so the
// music never stops because the game was idle or its frames were held back. Phones only allow an
// element to play after a tap; once it has, it may keep playing song after song.
const PUZZLETH_FADE_IN = 4, PUZZLETH_FADE_OUT = 6   // seconds, as in puzzleth/sound.py
var puzzleth_songs = [], puzzleth_queue = [], puzzleth_song = null, puzzleth_last_song = null
var puzzleth_music_on = false, puzzleth_music_level = 1, puzzleth_song_errors = 0

function puzzleth_song_element() {
    if (!puzzleth_song) {
        puzzleth_song = new Audio()
        puzzleth_song.preload = "auto"
        puzzleth_song.addEventListener("ended", puzzleth_next_song)
        puzzleth_song.addEventListener("timeupdate", puzzleth_fade_song)
        puzzleth_song.addEventListener("playing", () => { puzzleth_song_errors = 0 })
        puzzleth_song.addEventListener("error", () => {
            // unreachable (offline?) or unplayable: try the next one, but give up after a full round
            if (puzzleth_music_on && puzzleth_song.getAttribute("src") && ++puzzleth_song_errors < puzzleth_songs.length)
                setTimeout(puzzleth_next_song, 1000)
        })
    }
    return puzzleth_song
}

function puzzleth_next_song() {
    if (!puzzleth_music_on || !puzzleth_songs.length) return
    if (!puzzleth_queue.length) {
        puzzleth_queue = puzzleth_songs.slice()
        for (let i = puzzleth_queue.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [puzzleth_queue[i], puzzleth_queue[j]] = [puzzleth_queue[j], puzzleth_queue[i]]
        }
        // no song twice in a row
        if (puzzleth_queue.length > 1 && puzzleth_queue[puzzleth_queue.length - 1] === puzzleth_last_song)
            puzzleth_queue.unshift(puzzleth_queue.pop())
    }
    const song = puzzleth_song_element()
    puzzleth_last_song = puzzleth_queue.pop()
    song.src = puzzleth_last_song
    song.volume = 0
    if (!document.hidden)
        song.play().catch(() => {})  // refused until the first gesture: puzzleth_start_music
}

function puzzleth_fade_song() {
    const song = puzzleth_song
    if (!song || !puzzleth_music_on) return
    const t = song.currentTime, d = song.duration
    let f = Math.min(1, t / PUZZLETH_FADE_IN)
    if (isFinite(d) && d > 0)
        f = Math.min(f, Math.max(0, (d - t) / PUZZLETH_FADE_OUT))
    song.volume = Math.max(0, Math.min(1, puzzleth_music_level * f))
}
setInterval(puzzleth_fade_song, 100)

function puzzleth_play_music(songs) {
    puzzleth_songs = JSON.parse(songs)
    puzzleth_queue = []
    puzzleth_song_errors = 0
    puzzleth_music_on = true
    puzzleth_next_song()
}

function puzzleth_stop_music() {
    puzzleth_music_on = false
    if (puzzleth_song) {
        puzzleth_song.pause()
        puzzleth_song.removeAttribute("src")
        puzzleth_song.load()
    }
}

function puzzleth_music_volume(v) {
    puzzleth_music_level = v
    puzzleth_fade_song()
}

function puzzleth_start_music() {
    const media = puzzleth_media()
    if (media && media.paused)
        media.play().catch(() => {})
    if (puzzleth_music_on && puzzleth_song && puzzleth_song.paused && puzzleth_song.getAttribute("src"))
        puzzleth_song.play().catch(() => {})
}
for (const ev of ["pointerdown", "touchend", "keydown"])
    window.addEventListener(ev, puzzleth_start_music, true)
document.addEventListener("visibilitychange", () => {
    // quiet while the game is out of sight (another app, a locked phone), back when it returns
    if (!puzzleth_music_on || !puzzleth_song) return
    if (document.hidden) puzzleth_song.pause()
    else puzzleth_start_music()
})

// Keeping the screen on. A phone that dims and locks while a player is thinking over a puzzle would
// lose their place, so the game asks for the screen to stay on during puzzles (puzzleth_keep_awake,
// see puzzleth/web.py). Browsers let go of the lock whenever the page is hidden; it is asked for
// again when the page is back. The Android app (tools/android) keeps the screen on itself.
var puzzleth_awake = false, puzzleth_wake_lock = null

function puzzleth_keep_awake(on) {
    on = !!on
    if (on === puzzleth_awake) return
    puzzleth_awake = on
    if (window.PuzzlethAndroid) {
        try { PuzzlethAndroid.keepAwake(on) } catch (e) {}
    }
    puzzleth_check_wake_lock()
}

function puzzleth_check_wake_lock() {
    if (!navigator.wakeLock) return
    if (puzzleth_awake && !puzzleth_wake_lock && document.visibilityState === "visible") {
        puzzleth_wake_lock = "asking"
        navigator.wakeLock.request("screen").then((lock) => {
            puzzleth_wake_lock = lock
            lock.addEventListener("release", () => {
                if (puzzleth_wake_lock === lock) puzzleth_wake_lock = null
            })
            if (!puzzleth_awake) puzzleth_check_wake_lock()
        }).catch(() => { puzzleth_wake_lock = null })   // retried on the next tap
    } else if (!puzzleth_awake && puzzleth_wake_lock && puzzleth_wake_lock !== "asking") {
        const lock = puzzleth_wake_lock
        puzzleth_wake_lock = null
        lock.release().catch(() => {})
    }
}
document.addEventListener("visibilitychange", puzzleth_check_wake_lock)
for (const ev of ["pointerup", "keydown"])
    window.addEventListener(ev, puzzleth_check_wake_lock, true)

// Sound effects and spoken digits play through SDL's Web Audio context, not an <audio> element.
// Phones start it suspended and only let it run once resumed from inside a gesture that counts
// (touchend or pointerup; SDL itself waits for touchstart, which phones ignore). So every context
// the page makes is remembered and resumed on every tap or key press until it runs; a silent
// sound started in the same gesture is what older iPhones need as well. iPhones also mute Web Audio
// with the ringer switch unless the page asks to be treated like a media player.
const puzzleth_audio_contexts = []
for (const name of ["AudioContext", "webkitAudioContext"]) {
    const Base = window[name]
    if (!Base) continue
    window[name] = new Proxy(Base, {
        construct(target, args, newTarget) {
            const ctx = Reflect.construct(target, args, newTarget)
            puzzleth_audio_contexts.push(ctx)
            return ctx
        }
    })
}
try {
    if (navigator.audioSession) navigator.audioSession.type = "playback"
} catch (e) {}

function puzzleth_unlock_audio() {
    for (const ctx of puzzleth_audio_contexts) {
        if (ctx.state === "running" || ctx.state === "closed") continue
        try {
            const src = ctx.createBufferSource()
            src.buffer = ctx.createBuffer(1, 1, ctx.sampleRate)
            src.connect(ctx.destination)
            src.start(0)
        } catch (e) {}
        if (ctx.resume) ctx.resume().catch(() => {})
    }
}
for (const ev of ["pointerdown", "pointerup", "touchstart", "touchend", "mousedown", "keydown"])
    window.addEventListener(ev, puzzleth_unlock_audio, true)
document.addEventListener("visibilitychange", () => {
    // phones suspend audio when the tab is hidden; the next tap brings it back
    if (!document.hidden) puzzleth_unlock_audio()
})

// New tabs also need a gesture, and the game only sees a tap a moment after it happens. That is
// usually soon enough; when the browser (often Safari) refuses, the link opens on the tap's release.
var puzzleth_pending_url = null

// ("noopener" would make window.open return null even when it works, so the opener is cut here.)
function puzzleth_new_tab(url) {
    const tab = window.open(url, "_blank")
    if (tab)
        tab.opener = null
    return tab
}

function puzzleth_open_url(url) {
    if (window.PuzzlethAndroid) {   // the Android app (tools/android) opens it in the phone's browser
        try { PuzzlethAndroid.openUrl(url); return } catch (e) {}
    }
    if (!puzzleth_new_tab(url))
        puzzleth_pending_url = url
}

function puzzleth_open_pending() {
    if (puzzleth_pending_url) {
        puzzleth_new_tab(puzzleth_pending_url)
        puzzleth_pending_url = null
    }
}
for (const ev of ["pointerup", "touchend", "keyup"])
    window.addEventListener(ev, puzzleth_open_pending, true)

// Updates. Browsers keep the page and the game's download for a while (GitHub Pages lets them for 10
// minutes), and a phone's Home Screen app can sit on an old page for days. tools/build_web.sh names each
// build's download after its contents, so a fresh page always loads its own game, and writes the build's
// name here and into version.txt. That is asked for past every cache: when the game hasn't started yet a
// newer build is loaded straight away, later the menu offers it (puzzleth_update, see puzzleth/web.py).
const puzzleth_build = "@PUZZLETH_BUILD@"
var puzzleth_update = false
var puzzleth_started = false   // set by the game once it runs

function puzzleth_check_version() {
    if (puzzleth_build.startsWith("@")) return   // tools/build_web.sh --serve
    fetch("version.txt?t=" + Date.now(), {cache: "no-store"})
        .then((r) => r.ok ? r.text() : "")
        .then((latest) => {
            latest = latest.trim()
            if (!latest || latest === puzzleth_build) return
            // once per build, in case a cache still hands out the old page for the new address
            const tried = sessionStorage.getItem("puzzleth_reloaded") === latest
            if (!puzzleth_started && !tried) puzzleth_reload(latest)
            else puzzleth_update = true
        })
        .catch(() => {})
}

function puzzleth_reload(latest) {
    // a new address can't be answered from a cache
    sessionStorage.setItem("puzzleth_reloaded", latest || "")
    window.onbeforeunload = null   // pygbag's asks "Are you sure you want to navigate away?"
    const url = new URL(location.href)
    url.searchParams.set("v", latest || Date.now())
    location.replace(url.toString())
}

function puzzleth_set_started() {
    puzzleth_started = true
}

function puzzleth_update_ready() {
    return puzzleth_update
}

puzzleth_check_version()
document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") puzzleth_check_version()
})

// Requests to the online leaderboard (puzzleth/online.py). The game polls for each answer every frame
// with puzzleth_fetch_result, so it never waits on the network.
var puzzleth_answers = {}
var puzzleth_last_request = 0

function puzzleth_fetch(method, url, body, token) {
    const id = ++puzzleth_last_request
    const headers = {}
    if (body) headers["Content-Type"] = "application/json"
    if (token) headers["Authorization"] = "Bearer " + token
    fetch(url, {method, headers, body: body || undefined, signal: AbortSignal.timeout(15000)})
        .then(async (r) => { puzzleth_answers[id] = JSON.stringify({status: r.status, body: await r.text()}) })
        .catch(() => { puzzleth_answers[id] = JSON.stringify({status: 0, body: ""}) })
    return id
}

function puzzleth_fetch_result(id) {
    const answer = puzzleth_answers[id]
    if (answer === undefined) return ""
    delete puzzleth_answers[id]
    return answer
}

